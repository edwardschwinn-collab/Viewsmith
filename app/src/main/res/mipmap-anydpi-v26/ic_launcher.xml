<?xml version="1.0" encoding="utf-8"?>
<!-- The app icon in two layers. Android cuts it to whatever shape the phone
     uses (Samsung uses a rounded square) and can tilt the layers a bit for
     a parallax effect. The front layer is the camera and eye, rendered from
     design/viewsmith-icon-foreground.svg at each screen density. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
