<?xml version="1.0" encoding="utf-8"?>
<!-- ======================================================================
     AndroidManifest.xml: the app's "ID card" for Android.
     Declares permissions and which screen opens when you tap the icon.
     ====================================================================== -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to see through the camera -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- We draw with OpenGL ES 3 -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.PencilCam"
        android:allowBackup="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
